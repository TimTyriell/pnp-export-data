# Copy to .env and fill in. .env is gitignored.

# MediaWiki / Fandom Action API endpoint of your wiki
WIKI_API_URL=https://DEINWIKI.fandom.com/api.php

# Bot credentials — create under Special:BotPasswords on your wiki
WIKI_USERNAME=
WIKI_BOT_PASSWORD=

# Polite contact UA (required by Fandom API policy)
WIKI_USER_AGENT=pnp-fandom-service/0.1 (contact: you@example.com)

# Namespace generated pages land in for review (User, Draft, ...)
WIKI_DRAFT_NAMESPACE=User

# Local LLM via Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Review gate: 1 = dry-run (never writes to wiki), 0 = uploads allowed
FANDOM_DRY_RUN=1
