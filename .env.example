# Copy to .env and fill in. .env is gitignored.

# MediaWiki / Fandom Action API endpoint of your wiki
WIKI_API_URL=https://DEINWIKI.fandom.com/api.php

# Bot credentials — create under Special:BotPasswords on your wiki
WIKI_USERNAME=
WIKI_BOT_PASSWORD=

# Polite contact UA (required by Fandom API policy)
WIKI_USER_AGENT=pnp-fandom-service/0.1 (contact: you@example.com)

# Namespace generated pages land in for review (User, Draft, ...)
WIKI_DRAFT_NAMESPACE=User

# Read-only Knowledge-Base API (the memory repo, pnp-knowledge). The input.
PNP_KB_URL=http://127.0.0.1:8070

# Wiki page holding the generated episode overview table
PNP_STORY_OVERVIEW_PAGE=Stream Folgen

# Migration knob: how similar a live section must be to today's KB render
# before the merge reclaims it into the KI region (see wikimerge.py)
PNP_RECLAIM_SIMILARITY=0.8

# Review gate: 1 = dry-run (never writes to wiki), 0 = uploads allowed
FANDOM_DRY_RUN=1

# Seconds between consecutive wiki edits (Fandom rate-limits bulk writes)
FANDOM_EDIT_DELAY_S=3
